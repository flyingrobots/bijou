# escape=`
# Digest published in actions/runner-images Windows2022-Readme.md, 2026-11-12.
FROM mcr.microsoft.com/windows/servercore:ltsc2022@sha256:301d571fc0cffed67083d4cc7a10167f551212f76b3f91eb7457e89aa5a183da
# Host bootstrap verifies and extracts toolchain archives without executing them.
# No RUN, repository source, dependency installations or test artifacts in layers.
COPY node/ C:/node/
COPY git/ C:/Git/
COPY marker C:/bijou-test-seal
ENV PATH="C:\node;C:\Git\cmd;C:\Git\bin;C:\Windows\system32;C:\Windows;C:\Windows\System32\WindowsPowerShell\v1.0"
ENV HOME="C:\home" TEMP="C:\temp" TMP="C:\temp" GIT_CONFIG_NOSYSTEM="1" GIT_CONFIG_GLOBAL="NUL" npm_config_cache="C:\home\npm-cache"
USER ContainerAdministrator
CMD ["powershell", "-NoLogo", "-NoProfile", "-Command", "while ($true) { Start-Sleep -Seconds 30 }"]
