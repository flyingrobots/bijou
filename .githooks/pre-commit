#!/usr/bin/env sh
# Fast, dependency-free Code Dojo checks on the staged files. They need no
# Docker and no node_modules, so a commit takes seconds in any worktree.
# Tests are not a commit gate: GitHub CI runs the suite on every pull request,
# and `npm run verify:sealed` runs it in the seal before a release
# (docs/guides/sealed-tests.md).
set -eu
cd "$(git rev-parse --show-toplevel)"

node scripts/code-dojo/check-staged-files.mjs
node scripts/code-dojo/check-core-purity.mjs
node scripts/code-dojo/check-no-mocks.mjs
node scripts/code-dojo/check-graft-receipts.mjs
