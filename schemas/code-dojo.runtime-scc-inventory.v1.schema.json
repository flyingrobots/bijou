{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "code-dojo.runtime-scc-inventory.v1",
  "title": "Code Dojo runtime SCC inventory",
  "description": "scripts/code-dojo/baselines/runtime-scc.json, written by npm run code-dojo:cycles:write. The cyclic strongly connected components of the repository runtime import graph. A single JSON file, not JSON Lines. Byte-stable: no timestamps, everything sorted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "componentCount", "moduleCount", "components"],
  "definitions": {
    "module": { "type": "string", "minLength": 1, "pattern": "\\.tsx?$" }
  },
  "properties": {
    "schema": { "const": "code-dojo.runtime-scc-inventory.v1" },
    "componentCount": { "type": "integer", "minimum": 0 },
    "moduleCount": { "type": "integer", "minimum": 0 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "modules", "edges"],
        "properties": {
          "id": { "$ref": "#/definitions/module" },
          "area": { "type": "string", "minLength": 1 },
          "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/module" } },
          "edges": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/definitions/module" }
            }
          }
        }
      }
    }
  }
}
