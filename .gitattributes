# Every text file checks out with LF on every platform, so a Windows checkout
# reads the same bytes the seal does. Files below that must keep exact bytes say -text.
* text=auto eol=lf

# These licence texts were committed with CRLF; keep their bytes.
assets/fonts/dm-sans/OFL.txt -text
assets/fonts/space-grotesk/OFL.txt -text
docs/book/fonts/IBMPlexMono-OFL.txt -text

# Frozen publication evidence must retain exact bytes on every checkout.
docs/book/source-corpus.json -text
docs/book/build-report.json -text
docs/book/reader-delivery.json -text
docs/book/history/2026-10-20-before-progressive-build-report.json -text
docs/book/history/2026-10-20-before-progressive-reader-delivery.json -text

# Release witness hashes bind original bytes, including on CRLF-configured hosts.
fixtures/profunctor-page/project-keep/input/* -text
fixtures/profunctor-page/project-keep/generated/* -text
examples/docs/fixtures/graphql/navigation-list.graphql -text
tests/fixtures/RE-036/packed-bijou-cells.v1.json -text

# The image seal marker is compared byte for byte inside the worker.
scripts/docker-seal/marker -text

# The web-gpu showcase pins these Geordi files by SHA-256 (examples/web-gpu/geordi-pin.json).
examples/web-gpu/vendor/*.tgz binary

# Generated by npm run components:data and compared byte for byte by its drift test.
examples/components/generated/*.json text eol=lf

# The web-gpu showcase pins its CLI-installed registry files by SHA-256 of their raw bytes.
examples/web-gpu/src/vendor/** -text
examples/web-gpu/src/components/theme-provider.tsx -text
examples/web-gpu/src/components/theme-switch.tsx -text
