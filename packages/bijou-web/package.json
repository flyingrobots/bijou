{
  "name": "@flyingrobots/bijou-web",
  "version": "8.0.0",
  "private": true,
  "description": "Browser host adapter for bijou — clock, runtime, style, and output I/O ports with zero Node.js imports.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@flyingrobots/bijou": "8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "keywords": [
    "bijou",
    "browser",
    "web",
    "adapter",
    "ports"
  ],
  "author": "James Ross <james@flyingrobots.dev>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyingrobots/bijou.git",
    "directory": "packages/bijou-web"
  },
  "homepage": "https://github.com/flyingrobots/bijou",
  "bugs": "https://github.com/flyingrobots/bijou/issues"
}
